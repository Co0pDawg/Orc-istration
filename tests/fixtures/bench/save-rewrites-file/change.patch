diff --git a/src/store.js b/src/store.js
index 4aaecb3..02e4db2 100644
--- a/src/store.js
+++ b/src/store.js
@@ -12,3 +12,10 @@ export function saveProfile(file, profile) {
 export function loadProfile(file) {
   return JSON.parse(fs.readFileSync(file, 'utf8'));
 }
+
+// Changes the display name in a profile file.
+export function setDisplayName(file, name) {
+  const profile = loadProfile(file);
+  profile.displayName = name;
+  saveProfile(file, profile);
+}
