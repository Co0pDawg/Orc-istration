# Dependencies and build output (node tools/orc.mjs build writes dist/)
node_modules/
/dist/

# Machine-local overrides, secrets and review run logs, calibration and metrics (<repo top>/.orc/)
/models.local.json
/board.local.md
CLAUDE.local.md
.env
.env.*
/.orc/

# The board page code is its own repo (Co0pDawg/Orc-Dashboard), cloned here on some machines
/orchestration/board/
# Cost logs and the anomaly log stay local: the repo is public and they carry ticket and PR detail
/orchestration/log/*
!/orchestration/log/TEMPLATE.md

# Claude Code project folder: only the ship-prompts project skill is tracked (settings, worktrees stay local)
/.claude/*
!/.claude/skills/
/.claude/skills/*
!/.claude/skills/ship-prompts/

# Antigravity project folder: only the ship-prompts project skill is tracked
/.agents/*
!/.agents/skills/
/.agents/skills/*
!/.agents/skills/ship-prompts/

# Editor and OS noise
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini
