# Allow-list: everything in ~/.claude is ignored unless named below. This keeps transcripts,
# .credentials.json, caches, plugins, memory and logs out of the repo by default.
/*

!/.gitignore
!/.gitattributes
!/README.md
!/CLAUDE.md
!/AGENTS.md
!/models.json
!/package.json
# Tool-neutral core: roles, optional profiles, per-tool adapters, tests (dist/ and models.local.json stay untracked)
!/roles/
!/profiles/
!/adapters/
!/tests/
!/settings.example.json
!/hooks.node.example.json
# CI workflow
!/.github/

# The agent roster
!/agents/
/agents/*
!/agents/*.md

# The review panel: procedure, lanes and contract (tool-neutral)
!/review/

# Workflows (tool-neutral procedures) and the rulebook template for a target repo
!/workflows/
!/templates/

# Claude Code commands: the review panel and workflow wrappers (personal commands stay untracked)
!/commands/
/commands/*
!/commands/pre-pr-review.md
!/commands/review-verdict.md
!/commands/calibration-report.md
!/commands/start.md
!/commands/grill.md
!/commands/draft-pr.md
!/commands/peer-review.md
!/commands/create.md
!/commands/fix-ci.md

# Orchestration rules and cost logs (the board in orchestration/board is its own repo: Co0pDawg/Orc-Dashboard)
!/orchestration/
/orchestration/*
!/orchestration/README.md
# Cost logs stay local: the repo is public and they carry ticket and PR detail.

# Own skills only (synced and plugin skills reinstall themselves)
!/skills/
/skills/*

# Setup docs: restore guide and outlines for ops automation and project memory
!/docs/

# Own tools (source only; their data folders stay ignored)
!/tools/
!/CODEOWNERS
